#### implement Least Square Regression algorithm. #####
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
plt.rcParams['figure.figsize'] = (12.0, 9.0)
data = pd.read_csv(r'C\P04.csv')
X = data['Age (x)'][:6]
Y = data['Glucose level (y)'][:6]
age = data['Age (x)'][6]
# Plot initial scatter plot
plt.scatter(X, Y)
plt.xlabel('Age')
plt.ylabel('Glucose Level')
plt.title('Age vs Glucose Level')
plt.show()
# Calculate means
X_mean = np.mean(X)
Y_mean = np.mean(Y)
numerator = 0
denominator = 0
for i in range(len(X)):
    numerator += (X[i] - X_mean) * (Y[i] - Y_mean)
    denominator += (X[i] - X_mean) ** 2
b1 = numerator / denominator
b0 = Y_mean - (b1 * X_mean)
print("Slope (b1):", b1)
print("Intercept (b0):", b0)
print("\nLeast Square Regression Equation:")
print("Y =", b0, "+", b1, "* X")
predicted_glucose = b0 + b1 * age
print("\nAge:", age)
print("Predicted Glucose Level:", predicted_glucose)
Y_pred = b0 + b1 * X
plt.scatter(X, Y, label='Actual Data')
plt.plot(X, Y_pred, color='red', label='Least Square Regression Line')
plt.scatter(age, predicted_glucose, color='green', label=f'Prediction for Age {age}')
plt.xlabel('Age')
plt.ylabel('Glucose Level')
plt.title('Least Square Regression')
plt.legend()
plt.show()

