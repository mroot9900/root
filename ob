###### Candidate Elimination Algorithm #####
data = [
    ["Sunny", "Warm", "Normal", "Strong", "Warm", "Same", "Yes"],
    ["Sunny", "Warm", "High",   "Strong", "Warm", "Same", "Yes"],
    ["Rainy", "Cold", "High",   "Strong", "Warm", "Change", "No"],
    ["Sunny", "Warm", "High",   "Strong", "Cool", "Change", "Yes"]
]
S = data[0][:-1].copy()
G = [["?" for _ in range(len(S))]]
for row in data:
    features = row[:-1]
    target = row[-1]
    
    if target == "Yes":
        for i in range(len(S)):
            if S[i] != features[i]:
                S[i] = "?"    
        G = [g for g in G if all(g[i] == "?" or g[i] == features[i] for i in range(len(S)))]
        
    else: 
        new_G = []
        for g in G:
            for i in range(len(S)):
                if g[i] == "?" and S[i] != "?" and S[i] != features[i]:
                    specialized = g.copy()
                    specialized[i] = S[i]
                    new_G.append(specialized)
        G = new_G
print("Final S:", S)
print("Final G:", G)


