from itertools import permutations, product
TARGET = 15
def check(grid, include_diagonal=True):
  
  for i in range(0, 9, 3):
    if sum(grid[i : i + 3]) != TARGET:
      return False
    
  for i in range(3):
    if grid[i] + grid[i + 3] + grid[i + 6] != TARGET:
      return False

  if include_diagonal:
    if grid[0] + grid[4] + grid[8] != TARGET:
      return False
  return True

def print_grid(arr):
  for i in range(0, 9, 3):
    print(f"| {arr[i]} | {arr[i+1]} | {arr[i+2]} |")
  print("-" * 13)
print("1. One number can be repeated")
print("2. Specific set of numbers can be repeated")
print("3. No number can be repeated")
choice = int(input("Enter choice: "))
if choice == 1:
  num = int(input("Enter number: "))
  grid = [num] * 9
  if check(grid):
    print("\nSolution:")
    print_grid(grid)
  else:
    print("No valid grid possible.")
elif choice == 2:
  nums = list(map(int, input("Enter allowed set of numbers: ").split()))
  count = 0
  for grid in product(nums, repeat=9):
    if check(grid):
      count += 1
      print(f"\nSolution {count}:")
      print_grid(grid)
      if count == 5:
        break
  print(f"Total solutions displayed: {count}")
elif choice == 3:
  nums = list(map(int, input("Enter 9 distinct numbers: ").split()))
  limit = int(input("How many solutions do you want? "))
  found = 0
  for grid in permutations(nums):
    if check(grid):
      found += 1
      print(f"\nSolution {found}:")
      print_grid(grid)
      if found == limit:
        break
  print(f"Total solutions displayed: {found}")

else:
  print("Invalid Choice")


